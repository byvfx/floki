    "notes": {
      "egui": "Top-level surface, text, focus, mark, and functional keys are the shipping egui Chrome C theme. This qt block does not retint that theme.",
      "apply": "Load exactly one stylesheet. Do not cascade the three sheets.",
      "viewport": "QWidget#viewport stays transparent. The dead-flat surround is QWidget#viewportSurround. The renderer owns image pixels.",
      "lanes": "Timeline lanes are 22px, border-radius 0, edge to edge, with no in-bar text. Names live in QLabel#trackGutter.",
      "qssLimits": "Qt Style Sheets have no custom properties, calc, or drop-shadow. Glows, the cache hatch, the missing-frame dash, and the playhead triangle are paint events. Notes are in each sheet.",
      "fonts": "Register brand/fonts/*.ttf with QFontDatabase before applying a sheet. Tabular figures and wordmark tracking are QFont features, not QSS.",
      "overlays": "HUD, A/B badges, the wipe handle, annotation notes, and the contact sheet stay on the dark plate in every theme."
    },

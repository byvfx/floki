/target

# macOS Finder metadata
.DS_Store

# Official OpenEXR test-image corpus, cloned locally (~500 MB on disk). Its own
# upstream repo (AcademySoftwareFoundation/openexr-images, BSD-3-Clause) — not
# vendored, so it is ignored wholesale rather than relying on the *.exr rule:
# the Damaged/ fuzz corpus deliberately does NOT use a .exr extension, and would
# otherwise be committable. See TESTING.md.
assets/openexr-images/

# EXR test assets / renders (large binaries)
*.exr
# ...except the tiny committed DWA decode fixtures (<1 KB each): exrs can decode
# DWAA/DWAB but cannot *write* them, so these can't be generated synthetically at
# test time — they're the only way to regression-test DWA open support.
!tests/fixtures/*.exr

# Soak capture logs (#100) — `run-windows.ps1 soak` output. They carry footage
# paths (incl. client shares), so they are attached to issues deliberately, never
# committed.
soak-logs/

# Local agent guidance / runtime (not versioned)
# CLAUDE.md is tracked — it is shared project guidance, not per-machine state.
docs/review/
.pi/

# Archived/old screenshots (kept locally, not versioned)
assets/old-screenshots/
# Proprietary reference screenshots (kept locally for design reference, not
# versioned): the Chaos Player layout reference for the #99 layer-stack UI.
assets/pdplayer.png
